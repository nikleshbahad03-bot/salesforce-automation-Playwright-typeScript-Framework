# Copy this file to .env and replace placeholders with credentials for an authorized org.
BASE_URL=https://your-instance.my.salesforce.com
SF_INSTANCE_URL=https://your-instance.my.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=your-username@example.com
SF_PASSWORD=replace-with-your-password
SF_SECURITY_TOKEN=replace-with-your-security-token-if-required
SF_CLIENT_ID=replace-with-your-connected-app-client-id
SF_CLIENT_SECRET=replace-with-your-connected-app-client-secret
